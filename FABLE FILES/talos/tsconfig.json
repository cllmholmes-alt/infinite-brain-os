{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": [
    "packages/**/*.ts",
    "apps/api/**/*.ts",
    "apps/worker/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts"
  ]
}
