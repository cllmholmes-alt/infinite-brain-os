# OS artifacts
.DS_Store
Thumbs.db

# Editor temp files
*.tmp
*.swp
*~

# Node (if any local tooling is installed)
node_modules/

# Kilo tooling state (plans, agent manager, worktrees): local, never repo canon
.kilo/

# Tool runtime planes: operational substrate, never git canon
tools/*/runtime/
outputs/_runtime/
outputs/fusion-sync-receipts/**/*.bak

# Python
__pycache__/
*.pyc
.venv/

# Secrets: never commit these
.env
.env.local
*.secret
credentials.json
service-account-key.json
